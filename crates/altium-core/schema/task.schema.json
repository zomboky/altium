{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zomboky/altium/blob/main/crates/altium-core/schema/task.schema.json",
  "title": "Altium task",
  "description": "One line of .altium/tasks.jsonl (schema v1). Keys with a default value are omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "rev", "ca", "ua"],
  "properties": {
    "id": { "$ref": "#/$defs/taskId" },
    "title": { "type": "string" },
    "st": {
      "description": "Status. Omitted when todo.",
      "enum": ["todo", "doing", "blocked", "done", "cancelled"]
    },
    "pri": {
      "description": "Priority, P0 being the most urgent. Omitted when P2.",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "due": {
      "description": "Deadline in the user's local time zone: a date, optionally with a time.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2})?$"
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "parent": { "$ref": "#/$defs/taskId" },
    "pos": {
      "description": "Manual order among tasks of the same priority.",
      "type": "integer",
      "minimum": 0
    },
    "desc": { "description": "Description.", "type": "string" },
    "why": { "description": "Reason the task is blocked.", "type": "string" },
    "note": { "type": "string" },
    "rev": { "description": "Revision, incremented on every change.", "type": "integer", "minimum": 0 },
    "ca": { "description": "Creation time.", "$ref": "#/$defs/timestamp" },
    "ua": { "description": "Last update time.", "$ref": "#/$defs/timestamp" },
    "da": { "description": "Completion time.", "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "taskId": { "type": "string", "pattern": "^T-[1-9][0-9]*$" },
    "timestamp": {
      "description": "UTC, second precision.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
